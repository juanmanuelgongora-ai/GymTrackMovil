<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/black">

    <EditText
        android:id="@+id/etRoutineName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de la rutina"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        android:inputType="textCapSentences" />

    <EditText
        android:id="@+id/etRoutineDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Descripción (opcional)"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etExerciseCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nº ejercicios"
            android:inputType="number"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etDurationMin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:hint="Duración (min)"
            android:inputType="number"
            android:textColor="@color/white"
            android:textColorHint="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
