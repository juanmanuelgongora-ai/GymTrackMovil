<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_workout_card"
    android:padding="16dp">

    <!-- Row 1: Name + HOY badge + Arrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Name + HOY badge -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRoutineNameItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pecho &amp; Tríceps"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTodayBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOY"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_orange"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Arrow -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="#666666"/>
    </LinearLayout>

    <!-- Row 2: Day label -->
    <TextView
        android:id="@+id/tvRoutineDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoy"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"/>

    <!-- Row 3: Stats (time · kcal · exercises) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Time -->
        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_clock"
            android:tint="#888888"/>
        <TextView
            android:id="@+id/tvRoutineTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45 min"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginStart="4dp"/>

        <!-- Separator -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            android:textColor="#555555"
            android:textSize="12sp"/>

        <!-- Kcal -->
        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_fire"
            android:tint="#FF5722"/>
        <TextView
            android:id="@+id/tvRoutineKcal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="320 kcal"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginStart="4dp"/>

        <!-- Separator -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            android:textColor="#555555"
            android:textSize="12sp"/>

        <!-- Exercises -->
        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_dumbbell"
            android:tint="#888888"/>
        <TextView
            android:id="@+id/tvRoutineExercises"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 ejercicios"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

</LinearLayout>
